# Copy to `.env` and fill in with local values.
# `.env` is in .gitignore - it is never committed.

# PostgreSQL 17
PG_HOST=localhost
PG_PORT=5432
PG_USER=tpo
PG_PASSWORD=tpo
PG_DATABASE=tpo_facturacion

# MongoDB 8
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=tpo_facturacion
# Optional: full connection string override (replica sets / Atlas). If set, it
# takes precedence over MONGO_HOST/MONGO_PORT/MONGO_DATABASE.
# MONGO_URI=mongodb://localhost:27017/tpo_facturacion

# API (NestJS)
API_PORT=3000
