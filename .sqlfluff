[sqlfluff]
# Postgres-specific grammar (SERIAL, RETURNING, JSONB, ::, etc.)
dialect = postgres
# Disable line-length checks (long INSERTs are unavoidable) and allow SELECT *
exclude_rules = layout.long_lines, ambiguous.column_count

[sqlfluff:indentation]
# JOIN at same level as FROM
indented_joins = false
# ON clause indented one level under its JOIN
indented_using_on = true

[sqlfluff:rules:capitalisation.keywords]
# SELECT, FROM, WHERE, JOIN, GROUP BY... uppercase
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
# Table and column names lowercase (snake_case)
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
# COUNT, SUM, COALESCE, NOW... uppercase
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
# INT, VARCHAR, DATE, TIMESTAMP... uppercase
extended_capitalisation_policy = upper

[sqlfluff:rules:convention.not_equal]
# Use <> instead of !=
preferred_not_equal_style = ansi

[sqlfluff:rules:convention.casting_style]
# Use x::INT instead of CAST(x AS INT)
preferred_type_casting_style = shorthand
