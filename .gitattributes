# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text types
*.md       text
*.sql      text
*.json     text
*.yml      text
*.yaml     text
*.py       text
*.js       text
*.ts       text
*.sh       text eol=lf
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.gz       binary
